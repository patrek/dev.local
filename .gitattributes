# Fins de ligne LF pour les scripts shell (le bit exécutable se règle avec git update-index --chmod=+x)
*.sh text eol=lf

# Normaliser les fins de ligne
*.ps1 text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

